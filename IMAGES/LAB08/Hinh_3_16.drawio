<mxfile host="app.diagrams.net" type="device"><diagram name="Hinh_3_16" id="Hinh_3_16"><mxGraphModel page="1" pageWidth="1300" pageHeight="1695" background="#ffffff" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;ellipse;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="638" y="20" width="24" height="24" /></mxCell><mxCell id="n1" value="Chọn công ty, hợp đồng, các phòng và số tháng muốn gia hạn" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=24;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="75" width="480" height="80" /></mxCell><mxCell id="n2" value="Đọc Hợp đồng, Chi tiết hợp đồng, Văn phòng,&lt;br&gt;hạn hiện tại và lịch thuê tiếp theo" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=24;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="200" width="480" height="100" /></mxCell><mxCell id="n3" value="Còn hạn, số tháng&lt;br&gt;≤ 1/2 kỳ gốc?" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=20;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="345" width="280" height="120" /></mxCell><mxCell id="n3err" value="Báo sai phòng, đã hết hạn hoặc vượt giới hạn" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="348" width="350" height="90" /></mxCell><mxCell id="n3errend" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontC