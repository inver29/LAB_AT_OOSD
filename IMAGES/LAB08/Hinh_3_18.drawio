<mxfile host="app.diagrams.net" type="device"><diagram name="Hinh_3_18" id="Hinh_3_18"><mxGraphModel page="1" pageWidth="1360" pageHeight="2245" background="#ffffff" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;ellipse;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="638" y="20" width="24" height="24" /></mxCell><mxCell id="n1" value="Chọn kiểm tra phòng hoặc lập vi phạm từ phản ánh;&lt;br&gt;đọc Tầng, Văn phòng và lịch sử kiểm tra" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=24;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="75" width="480" height="100" /></mxCell><mxCell id="mode" value="Kiểm tra phòng?" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=20;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="220" width="280" height="120" /></mxCell><mxCell id="n2" value="Chọn phòng chưa kiểm tra trong năm hoặc cần kiểm tra lại;&lt;br&gt;kiểm tra thực tế, ghi ngày, kết quả và ghi chú" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=24;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="400" width="480" height="100" /></mxCell><mxCell id="n3" value="Dữ liệu kiểm tra&lt;br&gt;hợp lệ?" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=20;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="545" width="280" height="120" /></mxCell><mxCell id="n3err" value="Báo phòng/ngày/kết