<mxfile host="app.diagrams.net" type="device"><diagram name="Hinh_3_15" id="Hinh_3_15"><mxGraphModel page="1" pageWidth="1500" pageHeight="2190" background="#ffffff" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;ellipse;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="688" y="15" width="24" height="24" /></mxCell><mxCell id="choose" value="Công ty chọn một hoặc nhiều phòng và kỳ thuê;&lt;br&gt;Quản lý đọc Công ty, Văn phòng, Tầng và lịch thuê" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="75" width="520" height="100" /></mxCell><mxCell id="ok" value="Kỳ ≥ 6 tháng,&lt;br&gt;phòng/lịch hợp lệ?" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=22;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="225" width="300" height="120" /></mxCell><mxCell id="bad" value="Báo phòng Cần sửa, trùng lịch hoặc kỳ sai;&lt;br&gt;điều chỉnh và chọn lại" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="235" width="350" height="105" /></mxCell><mxCell id="save" value="Khóa phòng, kiểm tra lại; lưu hợp đồng, phòng và giá;&lt;br&gt;tạo hóa đơn 6 tháng đầu cùng giao dịch" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="415" width="520" height="120" /></mxCell><mxCell id="prepay" value="Kế toán đọc hóa đơn, đối chiếu thực nhận;&lt;br&gt;thu đủ, ngày đúng mới ghi ngày thanh toán" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="625" width="520" height="100" /></mxCell><mxCell id="paid" value="Đã thu đủ&lt;br&gt;6 tháng đầu?" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=22;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="755" width="300" height="120" /></mxCell><mxCell id="wait" value="Chưa bắt đầu thuê; giữ hóa đơn chưa thanh toán.&lt;br&gt;Thiếu tiền/sai ngày: báo để xử lý, không xác nhận thu." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="765" width="350" height="130" /></mxCell><mxCell id="we" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="183" y="955" width="24" height="24" /></mxCell><mxCell id="we_dot" value="" style="ellipse;strokeColor=#000000;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="188" y="960" width="14" height="14" /></mxCell><mxCell id="period" value="Bắt đầu kỳ cần xét; đọc hạn hiện tại của từng phòng&lt;br&gt;và các hóa đơn đã lập theo kỳ" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="1025" width="520" height="100" /></mxCell><mxCell id="month" value="Từ tháng 7?" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=22;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="1175" width="300" height="110" /></mxCell><mxCell id="rent" value="Đọc giá và kỳ; dùng hóa đơn đã có.&lt;br&gt;Chưa có: lập hóa đơn và dòng tiền thuê.&lt;br&gt;Thu đầu tháng; đủ tiền mới ghi ngày thu." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="1150" width="430" height="160" /></mxCell><mxCell id="usage" value="Đọc Dịch vụ, phòng thuê và kỳ đã tính;&lt;br&gt;chốt lượng thực tế, đơn giá và khoảng tính phí" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="1375" width="520" height="90" /></mxCell><mxCell id="has" value="Có dịch vụ?" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=22;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="1550" width="300" height="120" /></mxCell><mxCell id="service" value="Không tính lại khoảng đã lập. Tính lượng × đơn giá;&lt;br&gt;lưu hóa đơn dịch vụ và các dòng. Thu cuối tháng;&lt;br&gt;chỉ ghi ngày thanh toán khi nhận đủ." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="1525" width="430" height="175" /></mxCell><mxCell id="debt" value="Đối chiếu công nợ; chưa thu đủ thì chưa thanh toán.&lt;br&gt;Lỗi ghi: rollback, không báo thu thành công." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="1770" width="520" height="110" /></mxCell><mxCell id="more" value="Còn kỳ tiếp theo&lt;br&gt;trong hạn thuê?" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=22;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="1930" width="300" height="110" /></mxCell><mxCell id="done" value="Hết hạn thuê; giữ chứng từ để theo dõi&lt;br&gt;và thu các hóa đơn còn nợ." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1010" y="1920" width="450" height="110" /></mxCell><mxCell id="e" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1223" y="2110" width="24" height="24" /></mxCell><mxCell id="e_dot" value="" style="ellipse;strokeColor=#000000;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="1228" y="2115" width="14" height="14" /></mxCell><mxCell id="saved" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="680" y="555" width="40" height="40" /></mxCell><mxCell id="feesok" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="680" y="1475" width="40" height="40" /></mxCell><mxCell id="fixfees" value="Lượng sai/kỳ trùng: đối chiếu lại&lt;br&gt;trước khi lập hóa đơn." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=24;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="1440" width="350" height="110" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Times New Roman;fontSize=21;strokeColor=#000000;labelBackgroundColor=#ffffff;verticalAlign=bottom;endArrow=block;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="s" target="choose"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="700" y="39" /><mxPoint as="targetPoint" x="700" y="75" /><Array as="points" /></mxGeometry></mxCell><mxCell id="edge1" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Times New Roman;fontSize=21;strokeColor=#000000;labelBackgroundColor=#ffffff;verticalAlign=bottom;endArrow=block;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="choose" target="ok"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="700" y="175" /><mxPoint as="targetPoint" x="700" y="225" /><Array as="points" /></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Times New Roman;fontSize=21;strokeColor=#000000;labelBackgroundColor=#ffffff;verticalAlign=bottom;endArrow=block;exitX=0.0;exitY=0.5;exitPerimeter=0;entryX=1.0;entryY=0.47619047619047616;entryPerimeter=0;" edge="1" parent="1" source="ok" target="bad"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="550" y="285" /><mxPoint as="targetPoint" x="370" y="285" /><Array as="points" /></mxGeometry></mxCell><mxCell id="label2" value="Không" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=#ffffff;fontFamily=Times New Roman;fontSize=21;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="