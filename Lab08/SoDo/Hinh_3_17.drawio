<mxfile host="app.diagrams.net" type="device"><diagram name="Hinh_3_17" id="Hinh_3_17"><mxGraphModel page="1" pageWidth="1880" pageHeight="1580" background="#ffffff" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;ellipse;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="928.0" y="15" width="24" height="24" /></mxCell><mxCell id="read" value="Công ty báo hồ sơ và phương tiện; chọn nhân viên hoặc mã thẻ.&lt;br&gt;Đọc Công ty, Hợp đồng, Chi tiết hợp đồng, Văn phòng, Nhân viên và Thẻ giữ xe." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=26;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="460.0" y="80" width="960" height="130" /></mxCell><mxCell id="mode" value="Chọn thao tác" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="780.0" y="285" width="320" height="120" /></mxCell><mxCell id="a0" value="Quản lý nhập họ tên, chức vụ, ảnh;&lt;br&gt;chọn công ty và phòng làm việc" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="560" width="400" height="145" /></mxCell><mxCell id="q0" value="Đủ hồ sơ, đúng&lt;br&gt;phòng còn thuê?" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=21;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="790" width="280" height="135" /></mxCell><mxCell id="w0" value="Lưu Nhân viên gắn MaChiTietHD.&lt;br&gt;Suy ra công ty, tầng qua liên kết.&lt;br&gt;Ghi lỗi: rollback, không báo thành công." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1040" width="400" height="175" /></mxCell><mxCell id="e0" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="228" y="1250" width="24" height="24" /></mxCell><mxCell id="e0_dot" value="" style="ellipse;strokeColor=#000000;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="233" y="1255" width="14" height="14" /></mxCell><mxCell id="bad0" value="Báo trường thiếu hoặc phòng không&lt;br&gt;thuộc công ty / hết hạn; không lưu." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1360" width="400" height="115" /></mxCell><mxCell id="be0" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="228" y="1530" width="24" height="24" /></mxCell><mxCell id="be0_dot" value="" style="ellipse;strokeColor=#000000;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="233" y="1535" width="14" height="14" /></mxCell><mxCell id="a1" value="Bảo vệ nhập loại xe, biển số;&lt;br&gt;đọc nhân viên, hạn phòng và thẻ đang dùng" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="560" width="400" height="145" /></mxCell><mxCell id="q1" value="Người, phòng hợp lệ;&lt;br&gt;biển số chưa dùng?" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=21;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="790" width="280" height="135" /></mxCell><mxCell id="w1" value="Lưu thẻ, mã nhân viên, xe, ngày cấp;&lt;br&gt;ConHieuLuc = 1.&lt;br&gt;Lỗi ghi: rollback và báo lý do." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="1040" width="400" height="175" /></mxCell><mxCell id="e1" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="688" y="1250" width="24" height="24" /></mxCell><mxCell id="e1_dot" value="" style="ellipse;strokeColor=#000000;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="693" y="1255" width="14" height="14" /></mxCell><mxCell id="bad1" value="Từ chối cấp cho hồ sơ hết hiệu lực&lt;br&gt;hoặc biển số đã có thẻ đang dùng." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="1360" width="400" height="115" /></mxCell><mxCell id="be1" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="688" y="1530" width="24" height="24" /></mxCell><mxCell id="be1_dot" value="" style="ellipse;strokeColor=#000000;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="693" y="1535" width="14" height="14" /></mxCell><mxCell id="a2" value="Bảo vệ nhập/quét mã thẻ;&lt;br&gt;đối chiếu người và xe thực tế" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="960" y="560" width="400" height="145" /></mxCell><mxCell id="q2" value="Đúng người, xe;&lt;br&gt;thẻ/phòng hợp lệ?" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=21;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="790" width="280" height="135" /></mxCell><mxCell id="w2" value="Hiển thị thông tin và kết luận hợp lệ.&lt;br&gt;Không lưu lượt xe hoặc thu phí gửi xe." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="960" y="1040" width="400" height="175" /></mxCell><mxCell id="e2" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1148" y="1250" width="24" height="24" /></mxCell><mxCell id="e2_dot" value="" style="ellipse;strokeColor=#000000;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="1153" y="1255" width="14" height="14" /></mxCell><mxCell id="bad2" value="Báo thẻ không tồn tại, đã thu hồi&lt;br&gt;hoặc người, xe, phòng không hợp lệ." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="960" y="1360" width="400" height="115" /></mxCell><mxCell id="be2" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;stro