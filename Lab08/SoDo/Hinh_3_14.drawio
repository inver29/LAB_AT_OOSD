<mxfile host="app.diagrams.net" type="device"><diagram name="Hinh_3_14" id="Hinh_3_14"><mxGraphModel page="1" pageWidth="960" pageHeight="1580" background="#ffffff" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;ellipse;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="468.0" y="15" width="24" height="24" /></mxCell><mxCell id="read" value="Đọc Tầng, Văn phòng, Hợp đồng và Chi tiết hợp đồng;&lt;br&gt;khi quản lý danh mục, đọc thêm Công ty, Dịch vụ và hồ sơ đang tham chiếu" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=26;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="0.0" y="80" width="960" height="130" /></mxCell><mxCell id="mode" value="Chọn thao tác" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="320.0" y="285" width="320" height="120" /></mxCell><mxCell id="a0" value="Nhập tầng, hướng, diện tích&lt;br&gt;và khoảng thời gian cần thuê" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="560" width="400" height="145" /></mxCell><mxCell id="q0" value="Tiêu chí, ngày&lt;br&gt;hợp lệ?" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=21;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="790" width="280" height="135" /></mxCell><mxCell id="w0" value="Lọc phòng Đạt, không giao lịch thuê.&lt;br&gt;Hiển thị mã, tầng, diện tích, giá.&lt;br&gt;Không có phòng: thông báo để đổi tiêu chí." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1040" width="400" height="175" /></mxCell><mxCell id="e0" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="228" y="1250" width="24" height="24" /></mxCell><mxCell id="e0_dot" value="" style="ellipse;strokeColor=#000000;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="233" y="1255" width="14" height="14" /></mxCell><mxCell id="bad0" value="Báo tiêu chí/ngày sai;&lt;br&gt;không thay đổi dữ liệu." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1360" width="400" height="115" /></mxCell><mxCell id="be0" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="228" y="1530" width="24" height="24" /></mxCell><mxCell id="be0_dot" value="" style="ellipse;strokeColor=#000000;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="233" y="1535" width="14" height="14" /></mxCell><mxCell id="a1" value="Chọn danh mục và thao tác;&lt;br&gt;nhập trường bắt buộc, đọc mã trùng&lt;br&gt;và các chứng từ đang dùng" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="560" width="400" height="145" /></mxCell><mxCell id="q1" value="Dữ liệu đúng;&lt;br&gt;xóa: chưa được dùng?" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=21;rhombus;spacingLeft=28;spacingRight=28;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="790" width="280" height="135" /></mxCell><mxCell id="w1" value="Mở giao dịch, kiểm tra lại; lưu danh mục.&lt;br&gt;Giữ đơn giá trong chứng từ cũ.&lt;br&gt;Lỗi: rollback và báo lý do." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="1040" width="400" height="175" /></mxCell><mxCell id="e1" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="688" y="1250" width="24" height="24" /></mxCell><mxCell id="e1_dot" value="" style="ellipse;strokeColor=#000000;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="693" y="1255" width="14" height="14" /></mxCell><mxCell id="bad1" value="Sai dữ liệu, quyền hoặc mã trùng.&lt;br&gt;Bản đang được dùng không được xóa." style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=25;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="1360" width="400" height="115" /></mxCell><mxCell id="be1" value="" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;rounded=0;fontSize=23;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="688" y="1530" width="24" height="24" /></mxCell><mxCell id="be1_dot" value="" style="ellipse;strokeColor=#000000;fillColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="693" y="1535" width="14" height="14" /></mxCe