<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup useLegacyV2RuntimeActivationPolicy="true">
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<connectionStrings>
		<!-- Thay đổi Data Source cho phù hợp với máy của bạn -->
		<add name="QuanLyKhachSanDB"
			 connectionString="Data Source=.\MSSQLSERVER08;Initial Catalog=QuanLyKhachSan;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>